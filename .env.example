# Never put real credentials in this example file.
# These are the preferred credential keys for Android automation.
YANJIA_USERNAME=
YANJIA_PASSWORD=
# Optional compatibility aliases for migrated single-sheet login cases.
# When omitted, they inherit the YANJIA_* values at runtime.
TEST_USERNAME=
TEST_PASSWORD=

# Optional. When empty, the first store returned by the app is selected.
YANJIA_STORE_NAME=

# Device and Appium
ANDROID_UDID=
APPIUM_SERVER_URL=http://127.0.0.1:4723
APPIUM_STARTUP_TIMEOUT_SECONDS=60
YANJIA_APP_PACKAGE=com.xiaofutech.yanjia_ai
YANJIA_APP_ACTIVITY=.activity.SplashActivity
# Complete phone number of one controlled read-only customer seed. Keep the real
# value only in local .env or a process environment; never commit it.
SEEDED_CUSTOMER_PHONE=
# Enable only after the three Appium helper packages have been installed once.
APPIUM_SKIP_DEVICE_INITIALIZATION=false
APPIUM_SKIP_SERVER_INSTALLATION=false

# Safety switches. Keep all disabled by default.
YANJIA_RUN_SEEDED=false
YANJIA_ALLOW_MUTATION=false
YANJIA_ALLOW_DESTRUCTIVE=false
YANJIA_CAPTURE_SENSITIVE_ARTIFACTS=false
# Required for customer mutation. Use an isolated, uniquely searchable test customer.
# This value may contain personal data, so never commit a populated value.
YANJIA_MUTATION_CUSTOMER_QUERY=
# Keep false by default. Prefer the per-run switch after a fresh read-only preflight.
YANJIA_CUSTOMER_PREFLIGHT_VERIFIED=false
